{
  "Servers": [
    {
      "Name": "Local",
      "ConnectionString": "Server=localhost;Database=master;Integrated Security=True;TrustServerCertificate=True;",
      "BackupFolder": null
    }
  ],
  "DefaultServer": "Local",
  "Backup": {
    "DefaultFolder": "",
    "FileNamePattern": "{database}_{timestamp}.bak",
    "TimestampFormat": "yyyyMMdd_HHmmss",
    "CopyOnly": true,
    "Compression": true,
    "Checksum": true,
    "Verify": true,
    "IncludeSystemDatabases": false,
    "Retention": {
      "Enabled": false,
      "KeepLast": 7,
      "OlderThanDays": 30
    }
  }
}
